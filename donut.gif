import math
import time
import os

def spinning_donut():
    A, B = 0.0, 0.0
    chars = ".,-~:;=!*#$@"
    
    # Clear screen once and hide cursor
    os.system('cls' if os.name == 'nt' else 'clear')
    print("\x1b[?25l", end="")

    try:
        while True:
            z = [0.0] * 1760
            b = [' '] * 1760
            
            for j in range(0, 628, 7):       # theta (cross-sectional circle)
                for i in range(0, 628, 2):   # phi (center of revolution)
                    c = math.sin(i / 100)
                    d = math.cos(j / 100)
                    e = math.sin(A)
                    f = math.sin(j / 100)
                    g = math.cos(A)
                    h = d + 2
                    D = 1 / (c * h * e + f * g + 5)
                    l = math.cos(i / 100)
                    m = math.cos(B)
                    n = math.sin(B)
                    t = c * h * g - f * e
                    
                    # 3D to 2D screen projection
                    x = int(40 + 30 * D * (l * h * m - t * n))
                    y = int(12 + 15 * D * (l * h * n + t * m))
                    o = int(x + 80 * y)
                    
                    # Surface normal luminance index (0 to 11)
                    N = int(8 * ((f * e - c * d * g) * m - c * d * e - f * g - l * d * n))
                    
                    if 0 <= y < 22 and 0 <= x < 80 and D > z[o]:
                        z[o] = D
                        b[o] = chars[N if N > 0 else 0]
            
            # Move cursor to top-left and print frame
            print("\x1b[H", end="")
            for k in range(1760):
                print(b[k] if k % 80 else '\n', end="")
                
            A += 0.04
            B += 0.02
            time.sleep(0.03)
    except KeyboardInterrupt:
        print("\x1b[?25h")  # Restore cursor on exit

if __name__ == "__main__":
    spinning_donut()
